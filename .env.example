# Names only. Copy project-specific values into ignored local configuration.
# The static hub does not call Supabase or OpenAI yet.
SUPABASE_PROJECT_REF=your_project_reference
SUPABASE_URL=https://your_project_reference.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_project_publishable_key
SUPABASE_DB_PASSWORD=your_local_database_password
# Configure only when implementing and verifying the OpenAI review adapter.
OPENAI_API_KEY=your_openai_api_key
